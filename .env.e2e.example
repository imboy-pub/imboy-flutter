# E2E 联调测试配置模板
# 复制为 .env.e2e 并填入实际值
# cp .env.e2e.example .env.e2e

# 后端 API 地址（必填）
E2E_API_BASE_URL=http://127.0.0.1:9800

# WebSocket 地址（可选，未配置则自动从 /v1/init 获取）
E2E_WS_URL=ws://127.0.0.1:9800/ws

# 测试账号
E2E_TEST_PHONE=
E2E_TEST_PASSWORD=

# 第二个测试账号（用于双端消息联调，可选）
# E2E_TEST_PHONE2=
# E2E_TEST_PASSWORD2=

# Flutter 环境
E2E_APP_ENV=local_office

# 目标设备（macos / 安卓设备ID）
E2E_DEVICE=macos
