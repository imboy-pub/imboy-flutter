

# Apple App Store 数字 ID（iOS 升级页跳转用）
IOS_APP_ID=414478124

# for IMBoy app
API_BASE_URL=https://dev.imboy.pub

# 用于服务端和APP交互数据对称加密的密钥 32 位字符串， 需要和服务端一致
# Dart语言对特殊字符支持不是很友好，避免特殊字符
SOLIDIFIED_KEY=""
# IV 必须都为128比特，也就是16字节，需要和服务端一致
# Dart语言对特殊字符支持不是很友好，避免特殊字符
SOLIDIFIED_KEY_IV=""

# 键名必须与 lib/config/env_*.dart 中 @EnviedField(varName:) 的值一致，否则 envied 读不到
A_MAP_WEBS_KEY=
A_MAP_IOS_KEY=
A_MAP_ANDROID_KEY=

# 需要在 ./android/local.properties 文件里面设置 jpush.appKey参数为同样的key（注意=两端不要有空格）
JPUSH_APPKEY=

# 支付宝 App 支付（公开 appId 非密钥）；UL 统一用 pro 域名（AASA 仅部署在 pro.imboy.pub）
ALIPAY_APP_ID=2021004142626807
ALIPAY_UNIVERSAL_LINK=https://pro.imboy.pub/app/
