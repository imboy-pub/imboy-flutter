platform :osx, '12.4'

# rm -rf Podfile.lock pods .symlink Runner.xcworkspace && flutter clean && flutter pub get && pod install --repo-update
# source 'https://github.com/CocoaPods/Specs.git'
source 'https://mirrors.tuna.tsinghua.edu.cn/git/CocoaPods/Specs.git'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # hardening2 A4: flutter_sound 9.30.0 declares pluginClass FlutterSoundPlugin
  # for macOS but ships no macos/ implementation (pod install fails). Route it
  # to a local no-op shim so the GeneratedPluginRegistrant link holds; every
  # other plugin keeps the stock helper flow.
  plugins_root = File.dirname(File.realpath(__FILE__))
  symlink_dir = File.expand_path(File.join('Flutter', 'ephemeral', '.symlinks'), plugins_root)
  system('rm', '-rf', symlink_dir)
  system('mkdir', '-p', File.join(symlink_dir, 'plugins'))
  plugins_file = File.join(plugins_root, '..', '.flutter-plugins-dependencies')
  dependencies_hash = flutter_parse_plugins_file(plugins_file)
  plugin_pods = flutter_get_plugins_list(dependencies_hash, 'macos')
  symlink_plugins_dir = File.join(symlink_dir, 'plugins')
  plugin_pods.each do |plugin_hash|
    plugin_name = plugin_hash['name']
    plugin_path = plugin_hash['path']
    next unless plugin_name && plugin_path && plugin_hash.fetch('native_build', true)
    shared_darwin = plugin_hash.fetch('shared_darwin_source', false)
    platform_directory = shared_darwin ? 'darwin' : 'macos'
    symlink = File.join(symlink_plugins_dir, plugin_name)
    File.symlink(plugin_path, symlink)
    relative = flutter_relative_path_from_podfile(symlink)
    if plugin_name == 'flutter_sound'
      pod plugin_name, path: File.join('Shims', 'flutter_sound', 'macos')
    else
      pod plugin_name, path: File.join(relative, platform_directory)
    end
  end
  flutter_install_macos_engine_pod(plugins_root)
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    # 必须在 flutter_additional_macos_build_settings 之前统一部署目标：
    # helper 读取 target.deployment_target 时要求所有 configuration 取值一致，
    # flavor 配置（*-Standard）与旧配置在生成时初值不同会触发 consistency 错误。
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '12.4'
    end
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      # Shims 里的 vendored 源（flutter_sound 等）umbrella header 会引入
      # CocoaPods 拷贝的非模块头；pods 不得以 warnings-as-errors 构建。
      config.build_settings['GCC_TREAT_WARNINGS_AS_ERRORS'] = 'NO'
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
    end
  end
end

#pod 'JVerification'
pod 'PhoneNumberKit', '~> 3.8.0'
