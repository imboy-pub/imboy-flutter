<?xml version="1.0" encoding="utf-8"?>
<!--
  C05 OS 备份边界（Android legacy auto-backup，API < 31）。
  与 android:allowBackup="false" 的语义保持一致并显式落档：
  云备份/设备迁移不得携带任何应用数据——包括
  - SQLCipher 加密库（databases/）；
  - secure storage 后端的 SharedPreferences（Keystore AES 密文，
    密钥在 Android Keystore，恢复到新设备后也解不开，属废数据）。
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
